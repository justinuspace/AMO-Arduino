byte addClamped(byte value, byte amount) {
  int total = (int)value + (int)amount;
  return (byte)(total > 100 ? 100 : total);
}

float readTempC() {
  int raw = analogRead(NTC_PIN);
  if (raw <= 0 || raw >= 1023) return NAN;
  float resistance = SERIES_RESISTOR * (1023.0 / raw - 1.0);
  float t = log(resistance / NOMINAL_RESISTANCE) / BETA;
  t += 1.0 / (NOMINAL_TEMPERATURE + 273.15);
  return 1.0 / t - 273.15;
}

float readDistanceCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 20000UL);
  if (duration == 0) return -1.0;
  return duration * 0.0343 / 2.0;
}

int16_t readI16() {
  uint16_t hi = (uint8_t)Wire.read();
  uint16_t lo = (uint8_t)Wire.read();
  return (int16_t)((hi << 8) | lo);
}

bool detectMotionNow() {
  if (!mpuOK) return false;
  Wire.beginTransmission(0x68);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)0x68, (uint8_t)14) != 14) return false;
  int16_t ax = readI16(), ay = readI16(), az = readI16();
  (void)readI16();
  int16_t gx = readI16(), gy = readI16(), gz = readI16();
  bool moving = false;
  if (haveAcceleration) {
    long delta = labs((long)ax - prevAx) + labs((long)ay - prevAy)
               + labs((long)az - prevAz);
    moving = delta > 14000L || labs((long)gx) > 10000L
           || labs((long)gy) > 10000L || labs((long)gz) > 10000L;
  }
  prevAx = ax;
  prevAy = ay;
  prevAz = az;
  haveAcceleration = true;
  return moving;
}

